# ==============================================================================
# TESSERA — AI Implementation Studio (Azentio Hackathon Challenge #8)
# Environment Configuration Template
# Copy this file to .env or .env.local and enter your credentials. NEVER commit .env
# ==============================================================================

# Provider Credentials (leave blank for deterministic offline demonstration mode)
GROQ_API_KEY=
LLAMA_CLOUD_API_KEY=

# Model Preferences & Reasoning
GROQ_PRIMARY_MODEL=openai/gpt-oss-20b
GROQ_COMPLEX_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# Feature Flags
LLAMA_PARSE_ENABLED=false
LLAMA_PARSE_TIER=cost_effective
ENABLE_SECOND_MODEL_REVIEW=false
DEMO_MODE=true

# Storage & Database
DATABASE_URL=sqlite:///./data/tessera.db
STORAGE_ROOT=./data/uploads
MAX_UPLOAD_MB=25
APP_ORIGIN=http://localhost:5173
